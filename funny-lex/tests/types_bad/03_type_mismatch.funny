mix(a:int[], n:int) returns r:int, b:int[] {
    r = a + 1;                  // массив в арифметике
    r = n[0];                   // n — не массив
    r = a[a];                   // индекс — массив
    b = a;
    b[0] = a;                   // элемент массива — массив
    r = b;                      // int[] в int
    x = 1;
    x = a;                      // x уже int
    r = -a;                     // унарный минус у массива
    r = length(n);              // length от int
    r = length(a, a);           // length с двумя аргументами
    if (a == a) r = 1;          // сравнивать можно только int
}
