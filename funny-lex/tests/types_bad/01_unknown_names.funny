helper(x:int) returns y:int { y = x; }

main() returns r:int {
    r = x + 1 + x;              // x неизвестна (сообщение одно, хотя x дважды)
    r = foo(1);                 // неизвестная функция
    r = later + 1;              // later объявится только ниже
    later = 2;
    r = helper;                 // имя функции вместо переменной
    r = r(1);                   // переменная вместо функции
}
