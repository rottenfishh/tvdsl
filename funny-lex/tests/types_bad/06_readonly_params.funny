// параметры (и массивы-параметры) только для чтения — T1 проекта
upd(a:int[], n:int) returns b:int[], m:int {
    n = n + 1;                  // запись в параметр
    a[0] = 1;                   // обновление параметра-массива: тоже запись в a
    n, m = pair();              // запись в параметр через кортеж
    b = a;
    b[0] = 1;                   // а копию менять можно
}

pair() returns p:int, q:int { p = 1; q = 2; }
