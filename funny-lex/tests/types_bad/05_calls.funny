two(x:int) returns p:int, q:int { p = x; q = x; }
one(a:int[]) returns r:int { r = a[0]; }

main(a:int[]) returns r:int {
    r = one(a, a);              // число аргументов
    r = one(1);                 // тип аргумента
    r = two(1) + 1;             // несколько результатов внутри выражения
    r = two(1);                 // несколько результатов в одну переменную
    x, y, z = two(1);           // 2 результата, а слева 3 переменные
    u, v = one(a);              // 1 результат, а слева 2 переменные
}
