// бесполезный код: unused не нужна; но деление на переменную и a[i] — могут упасть, их не удаляем
f(x:int, y:int, a:int[]) returns r:int {
    unused = x * 100 + y;    // не используется -> удаляется
    d = x / y;               // результат не нужен, но при y == 0 — ошибка: оставляем
    e = a[x];                // при выходе за границы — ошибка: оставляем
    k = x / 2;               // деление на ненулевую константу упасть не может -> удаляется
    r = x + 1;
}
