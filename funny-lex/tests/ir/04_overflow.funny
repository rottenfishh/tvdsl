// свёртка обязана давать то же, что JVM: 32-битное переполнение и деление к нулю
f(x:int) returns a:int, b:int, c:int, d:int {
    a = 2147483647 + 1;      // -2147483648
    b = -7 / 2;              // -3 (а не -4, как в Python)
    m = 0 - 2147483647 - 1;  // минимальный int
    c = m / -1;              // переполнение: снова -2147483648
    d = 0 / 5 + x * 0;       // 0
}
