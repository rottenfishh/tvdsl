// свёртка констант, алгебра, удаление недостижимой ветки
calc(x:int) returns r:int {
    a = 3;
    b = a + 4;               // 7
    c = b * 2;               // 14
    if (b < 10) {            // 7 < 10 -> true: ветка else недостижима
        r = x * 1 + 0 + c;   // x * 1 -> x, + 0 исчезает
    } else {
        r = x / 0;           // никогда не выполнится -> удаляется целиком
    }
    r = r - (a - 3) * x;     // (a - 3) = 0, 0 * x = 0, r - 0 = r
}
