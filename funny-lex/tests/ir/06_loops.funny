// циклы: живость через границы блоков; копии и константы внутри тела цикла
gcd(a:int, b:int) returns g:int {
    x = a;
    y = b;
    while (y != 0) {
        t = x - x / y * y;     // x mod y
        x = y;
        y = t;
    }
    g = x;
}

sum_sq(n:int) returns s:int {
    s = 0;
    i = 1;
    while (i <= n) {
        s = s + i * i;
        i = i + 1;
    }
}

bubble(a:int[]) returns b:int[] {
    b = a;
    n = length(b);
    i = 0;
    while (i < n) {
        j = 0;
        while (j + 1 < n - i) {
            if (b[j] > b[j + 1]) {
                tmp = b[j];
                b[j] = b[j + 1];
                b[j + 1] = tmp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}
