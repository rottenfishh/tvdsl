// цикл с инвариантом и без; requires / ensures
sum(n:int) requires n >= 0 returns r:int ensures r == n * (n - 1) / 2 {
    i = 0;
    r = 0;
    while (i < n)
        invariant 0 <= i and i <= n and r == i * (i - 1) / 2
    {
        r = r + i;
        i = i + 1;
    }
    while (i > 0) i = i - 1;
}
