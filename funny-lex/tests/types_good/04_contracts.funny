// контракты: requires — только параметры, ensures — параметры и результаты,
// invariant/assert/assume — всё, что объявлено к этому месту; формулы и кванторы — только в предикатах
nonneg(a:int[], n:int) => forall (k:int | 0 <= k and k < n -> a[k] >= 0);

sorted_from(a:int[], l:int) => forall (k:int | l <= k and k + 1 < length(a) -> a[k] <= a[k + 1]);

count_pos(a:int[]) requires nonneg(a, length(a)) returns c:int ensures c >= 0 and c <= length(a) {
    c = 0;
    i = 0;
    assume length(a) >= 0;
    while (i < length(a))
        invariant 0 <= i and c <= i and nonneg(a, i) or exists (j:int | j == i)
    {
        if (a[i] > 0) c = c + 1;
        i = i + 1;
    }
    assert c <= i and (sorted_from(a, 0) -> true);
}
